diff --git a/crates/pi-natives/src/clipboard_android.rs b/crates/pi-natives/src/clipboard_android.rs
new file mode 100644
index 0000000..0a25a5e
--- /dev/null
+++ b/crates/pi-natives/src/clipboard_android.rs
@@ -0,0 +1,39 @@
+//! Clipboard stub for Android.
+//!
+//! arboard does not support Android, so clipboard operations are no-ops here.
+
+use napi::{JsString, bindgen_prelude::*};
+use napi_derive::napi;
+
+use crate::task;
+
+/// Clipboard image payload encoded as PNG bytes.
+#[napi(object)]
+pub struct ClipboardImage {
+	/// PNG-encoded image bytes.
+	pub data:      Uint8Array,
+	/// MIME type for the encoded image payload.
+	pub mime_type: String,
+}
+
+/// Android stub: clipboard not supported.
+#[napi]
+pub fn copy_to_clipboard(_text: JsString) -> Result<()> {
+	Err(Error::from_reason("Clipboard not supported on Android"))
+}
+
+/// Android stub: clipboard not supported.
+#[napi]
+pub fn read_text_from_clipboard() -> task::Promise<Option<String>> {
+	task::blocking("clipboard.read_text", (), move |_| -> Result<Option<String>> {
+		Ok(None)
+	})
+}
+
+/// Android stub: clipboard not supported.
+#[napi]
+pub fn read_image_from_clipboard() -> task::Promise<Option<ClipboardImage>> {
+	task::blocking("clipboard.read_image", (), move |_| -> Result<Option<ClipboardImage>> {
+		Ok(None)
+	})
+}
